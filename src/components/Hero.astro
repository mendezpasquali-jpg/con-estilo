---
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import Pendiente from './Pendiente.astro';
import EstadoAbierto from './EstadoAbierto.astro';
import { portada } from '../data/contenido';
import { sitio, enlaceWhatsApp } from '../data/sitio';
---
<section class="hero" aria-labelledby="hero-h1">
  <div class="contenedor">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="flex flex-col justify-end lg:col-span-8 lg:pb-2">
        <h1 id="hero-h1" class="etiqueta hero-in" style="--d:0">{portada.h1}</h1>

        <p class="display mt-7 md:mt-9">
          {portada.frase.map((linea, i) => (
            <span class="linea"><span class="hero-linea" style={`--d:${i + 1}`}>{linea} </span></span>
          ))}
        </p>

        <Pendiente nota={portada.pendiente} class="mt-8 max-w-[34rem] md:mt-10">
          <p class="lead hero-in" style="--d:3">{portada.bajada}</p>
        </Pendiente>

        <div class="hero-in mt-9 flex flex-wrap items-center gap-x-8 gap-y-3" style="--d:4">
          <a href={enlaceWhatsApp()} class="btn" target="_blank" rel="noopener">
            <Icono nombre="whatsapp" /> Pedir turno por WhatsApp
          </a>
          <a href="#servicios" class="enlace">Ver servicios <Icono nombre="flecha" /></a>
        </div>
      </div>

      <div class="lg:col-span-4 lg:col-start-9">
        <figure class="hero-foto">
          <Foto
            proporcion="4 / 5"
            falta="Foto principal: Carla trabajando en el local, luz natural, vertical"
            prioridad
            sizes="(min-width: 64rem) 32vw, 100vw"
          />
          <figcaption class="etiqueta mt-4 flex items-center justify-between gap-4">
            <span>{sitio.direccion.calle}</span>
            <span>{sitio.direccion.barrio}</span>
          </figcaption>
        </figure>
      </div>
    </div>

    <ul class="hero-datos hero-in" style="--d:5">
      <li>
        <a href={sitio.google.ficha} target="_blank" rel="noopener" class="dato-enlace">
          <span class="estrellas" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => <Icono nombre="estrella" class="h-3.5 w-3.5" />)}
          </span>
          <span><b class="font-medium text-tinta">{String(sitio.google.puntaje).replace('.', ',')}</b> en Google · {sitio.google.opiniones} opiniones</span>
        </a>
      </li>
      <li><EstadoAbierto /></li>
      <li>
        <a href={sitio.google.comoLlegar} target="_blank" rel="noopener" class="dato-enlace">
          <Icono nombre="ubicacion" class="h-4 w-4" />
          <span>{sitio.direccion.calle}, {sitio.direccion.barrio}</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--alto-header) + clamp(2rem, 4.5vw, 4rem));
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }
  .linea { display: block; overflow: clip; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .hero-linea { display: inline-block; }

  .hero-foto :global(.foto) { clip-path: inset(0); }

  .hero-datos {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 4.5vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-bruma);
    font-size: 0.9375rem;
    color: var(--color-grafito);
  }
  @media (min-width: 48rem) {
    .hero-datos { grid-template-columns: repeat(3, auto); justify-content: space-between; align-items: center; }
  }
  .hero-datos > li { display: flex; align-items: center; min-height: 2.75rem; }
  .dato-enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-rapida) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .dato-enlace:hover { color: var(--color-tinta); text-decoration: underline; text-underline-offset: 0.3em; text-decoration-thickness: 1px; }
  }
  .estrellas { display: inline-flex; gap: 2px; color: var(--color-tinta); }

  /* Entrada: todo se mueve, nada arranca invisible. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-linea { animation: linea 1.3s var(--ease-out) both; animation-delay: calc(var(--d) * 110ms + 100ms); }
    .hero-in { animation: sube 1.1s var(--ease-out) both; animation-delay: calc(var(--d) * 110ms + 100ms); }
    .hero-foto :global(.foto) { animation: descubre 1.6s var(--ease-out) 150ms both; }
    .hero-foto :global(.foto > *) { animation: acerca 1.9s var(--ease-out) 150ms both; }
  }
  @keyframes linea { from { transform: translateY(45%); } to { transform: none; } }
  @keyframes sube { from { transform: translateY(1.5rem); } to { transform: none; } }
  @keyframes descubre { from { clip-path: inset(7% 7% 7% 7%); } to { clip-path: inset(0); } }
  @keyframes acerca { from { transform: scale(1.12); } to { transform: none; } }
</style>
